{
// default_glyphborn_common.json

// Runic Nail
// flat durability penalty
  "runic_nail_flat_penalty":    40.0,
// percent penalty based on the item's max durability
  "runic_nail_percent_penalty": 0.22,

// Field Repair Kit
// how much of the missing durability gets restored
  "field_repair_percent":       0.35,
// flat durability removed after repair
// the kit won't be consumed if the repaired result would be <= this value
  "field_repair_flat_penalty":  12,

// Rune extraction penalty
// chance to trigger a negative effect on extraction. 0.01 = 1%
  "rune_extract_effect_chance": 0.07,
// effects applied when the penalty triggers
  "rune_extract_effects": [
    { "id": "minecraft:mining_fatigue",     "duration_ticks": 400, "amplifier": 3 },
    { "id": "minecraft:weakness",           "duration_ticks": 400, "amplifier": 3 },
    { "id": "minecraft:blindness",           "duration_ticks": 400, "amplifier": 3 },
    { "id": "minecraft:slowness",           "duration_ticks": 400, "amplifier": 3 }
  ],

// Rune drop filters
  "only_hostile":             true,
  "ignore_spawner":           true,
  "require_player_kill":      true,
  "allow_tamed_kill":         true,
  "looting_bonus_per_level":  0.03,

// minimum mob health required for runes to drop
  "drop_health_floor":        8.0,
  // mob health at which drop chance and budget reach their maximum.
// mobs at or above this value always use the max values
  "drop_health_ceiling":      200.0,

// drop chance at mob health == drop_health_floor. 0.01 = 1%
  "drop_chance_min":          0.04,
// drop chance at mob health >= drop_health_ceiling
  "drop_chance_max":          0.35,
// sqrt = square root, linear = linear, exp = exponential
  "drop_chance_curve":        "sqrt",
// maximum bonus to drop chance based on the mob's size
  "size_chance_bonus_max":    0.20,

// drop budget controls the ceiling for rune count and quality
// applied at mob health == drop_health_floor
  "base_drop_budget":         4.0,
// applied at mob health >= drop_health_ceiling
  "drop_budget_cap":          20.0,
// sqrt = square root, linear = linear, exp = exponential
  "drop_budget_curve":        "sqrt",
  "size_budget_bonus_max":    0.25,

// rune tier cost within the drop budget
// default: T5 = 3 (cheapest), T1 = 15 (most expensive)
  "rune_tier_cost_min":       3.0,
  "rune_tier_cost_max":       15.0,
// sqrt = square root, linear = linear, exp = exponential
  "rune_tier_cost_curve":     "linear",

// max runes that can drop from a single kill
  "max_drops_per_kill":       4,

// per-dimension drop chance and budget multipliers
  "dimension_multipliers": {
    "minecraft:the_nether": { "chance": 1.3, "budget": 1.2 },
    "minecraft:the_end":    { "chance": 1.5, "budget": 1.4 }
  },

  
// per-mob overrides
// "chance_override" — replaces the calculated drop chance. 0.01 = 1%. -1 = use formula
// "budget_add" — added on top of the calculated budget
// "ignore_formula" — true = use only the whitelist fields, skip the formula entirely
// "extra_rolls" — additional attempts to improve rune tier. more = better results on average
// "unique_runes" — unique rune drop rules
// "pool" — specific rune IDs to draw from (empty = all runes marked "unic": true)
// "shared_chance" — true = one roll for the whole pool, false = individual roll per rune
// "chance" — drop chance for unique runes. 0.01 = 1%. only affected by dimension multipliers
  "whitelist": [
    {
      "id": "minecraft:ender_dragon",
      "chance_override": 1.0,
      "budget_add": 25.0,
      "ignore_formula": true,
      "extra_rolls": 3,
      "unique_runes": {
        "pool": [],
        "shared_chance": true,
        "chance": 0.04
      }
    },
    {
      "id": "minecraft:wither",
      "chance_override": 1.0,
      "budget_add": 22.0,
      "ignore_formula": true,
      "extra_rolls": 3,
      "unique_runes": {
        "pool": [],
        "shared_chance": true,
        "chance": 0.04
      }
    }
  ],

// blocks rune drops for listed mobs
// supports tags: "#minecraft:skeletons"
  "blacklist": [
    "minecraft:bat",
    "minecraft:cod",
    "minecraft:salmon",
    "minecraft:tropical_fish",
    "minecraft:pufferfish",
    "minecraft:squid",
    "minecraft:glow_squid"
  ],

// Reagent (Pouch of Embers)
// Number of modifier slots inside each reagent
  "reagent_slots": 4,

// Items that can be placed into reagent slots as modifiers (item id or #tag)
// Format: "item_id": "effect_type"
// Effect types:
//   tier_reroll:    +-N tiers on random affixes (iron default)
//   amplification:  +N to all other effect values (gold default)
//   target_worst:   prioritize effects on worst-tier affixes (copper default)
//   target_best:    prioritize effects on best-tier affixes (lapis default)
//   reforge:        +-N to item tier (emerald default)
//   redefinition:   full re-roll of all affixes (netherite default, incompatible)
//   corruption:     +-10% to 1 affected affix, locks it (obsidian default)
//   base:           reroll value preserving tier (for custom items)
  "reagent_modifiers": {
    "minecraft:iron_ingot": "tier_reroll",
    "minecraft:gold_ingot": "amplification",
    "minecraft:copper_ingot": "target_worst",
    "minecraft:diamond": "target_best",
    "minecraft:emerald": "reforge",
    "minecraft:netherite_ingot": "redefinition",
    "minecraft:ghast_tear": "corruption"
  }
}
