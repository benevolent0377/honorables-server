{
// item rules
// types are used for fine-grained balance control — they act as filters only
// rune stats are only applied to items whose type matches
// item types: "melee", "range", "thrown", "melee_second", "armor", "tools", "magic", "curios"
// multiple types are allowed: "types": ["melee", "range"] — matches melee and range items
// for Curios items use "types": ["curios"] for all slots, or "types": ["curios:ring"] for a specific slot
// "socket": [min, max] number of rune slots
// "items": accepts direct item IDs or tags prefixed with "#" (e.g. "#forge:swords")
// "mult": true — stat multiplier. ignores flat bonuses from glyphborn_runes.json
// "mult": false — flat bonus. applied after all other calculations
// formula: ((item base * item mult from glyphborn_items.json) + item flat from glyphborn_items.json)
//          * (1 + sum of all rune multiplier bonuses) + sum of all rune flat bonuses
// "itspercent": true — displays the value as a percentage. 0.01 = 1%. does not affect calculations

// item tier weights — ordered worst to best
// number of entries defines number of tiers
// item tier is the upper bound for affix tiers (item T3 → affixes can be T1–T3)
  "item_tier_weights": [35, 28, 20, 17],
//35 + 28 + 20 + 14 = 97
// T4 (worst): 35/97 = 36.1%
// T3: 28/97 = 28.9%
// T2: 20/97 = 20.6%
// T1 (best): 14/97 = 14.4%

// geometric tier widths with overlap
// width_growth (r): each tier is r times wider than previous (r=2 means T3 is 2x T4 width)
// overlap (p): next tier starts at (1-p) of current tier's width (0.5 = 50% overlap)
// formula: w0 = (B-A) / (S_N - p*S_{N-1}) where S_k = (r^k - 1)/(r - 1)
  "item_tier_width_growth": 1.7,
  "item_tier_overlap": 0.7,
