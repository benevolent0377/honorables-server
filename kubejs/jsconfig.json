{
    "compilerOptions": {
        "lib": [
            "ES5",
            "ES2015"
        ],
        "rootDirs": [
            "probe/generated",
            "probe/user",
            "server_scripts",
            "startup_scripts",
            "client_scripts",
            "types"
        ],
        "target": "ES2015"
    },
    "include": [
        "server_scripts/**/*.js",
        "startup_scripts/**/*.js",
        "client_scripts/**/*.js",
        "probe/generated/**/*.d.ts",
        "types/**/*.d.ts"
    ]
}
